# Pinecone Serverless Configuration
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_INDEX_NAME="spotify-support-cases"
PINECONE_CLOUD="aws"
PINECONE_REGION="us-east-1"

# LLM Providers (Groq is default: groq/openai/gpt-oss-120b)
GROQ_API_KEY="gsk_your_groq_api_key"
GEMINI_API_KEY="your_gemini_api_key"

# Model & Threshold Configurations
LLM_MODEL="groq/openai/gpt-oss-120b"
GROQ_MODEL="groq/openai/gpt-oss-120b"
SENTIMENT_MODEL="groq/openai/gpt-oss-120b"
JUDGE_MODEL="groq/openai/gpt-oss-120b"
RAG_CONFIDENCE_THRESHOLD="0.70"

# UI Server (optional)
# API_HOST=0.0.0.0
# API_PORT=8000

# osTicket Helpdesk Integration
OSTICKET_URL="http://localhost:8088"
OSTICKET_STAFF_USER="ostadmin"
OSTICKET_STAFF_PASS="Admin1"
OSTICKET_ADMIN_USER="ostadmin"
OSTICKET_ADMIN_PASS="Admin1"
