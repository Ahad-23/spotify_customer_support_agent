# Pinecone Serverless Configuration
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_INDEX_NAME="spotify-support-cases"
PINECONE_CLOUD="aws"
PINECONE_REGION="us-east-1"

# LLM Providers (Groq is default, Gemini and OpenAI are optional alternatives)
GROQ_API_KEY="gsk_your_groq_api_key"
GEMINI_API_KEY="your_gemini_api_key"
OPENAI_API_KEY="sk-your_openai_api_key"

# Optional Model & Threshold Configurations
GROQ_MODEL="openai/gpt-oss-120b"
GEMINI_MODEL="gemini-3.8-flash"
OPENAI_MODEL="gpt-4o-mini"
RAG_CONFIDENCE_THRESHOLD="0.70"

# UI Server (optional)
# API_HOST=0.0.0.0
# API_PORT=8000

# Optional global overrides
# LLM_MODEL="groq/openai/gpt-oss-120b"
# SENTIMENT_MODEL="groq/openai/gpt-oss-120b"
# JUDGE_MODEL="groq/openai/gpt-oss-120b"
